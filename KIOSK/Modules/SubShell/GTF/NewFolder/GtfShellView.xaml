<UserControl
    x:Class="KIOSK.Modules.GTF.Shell.GtfShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Modules.GTF.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  Default Layer  -->
        <ContentControl Content="{Binding CurrentView}" />

        <!--  Popup Layer  -->
        <ContentControl Panel.ZIndex="500" Content="{Binding LocalPopupViewModel}">

            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <!--  Default Hidden  -->
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocalPopupOpen}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
