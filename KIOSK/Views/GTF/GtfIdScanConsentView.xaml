<UserControl
    x:Class="KIOSK.Views.GTF.GtfIdScanConsentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Views.GTF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="860"
    d:DesignWidth="1920"
    Background="{StaticResource SecondaryBrush}"
    mc:Ignorable="d">
    <Grid Width="1000" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <ListBox
            Grid.Row="1"
            Padding="16"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Focusable="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectionMode="Single">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel>
                                    <!--  헤더: ToggleButton로 구현 (기본 라디오/체크 아이콘 없음)  -->
                                    <ToggleButton
                                        x:Name="HeaderBtn"
                                        Padding="16,12"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#111827"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Grid SnapsToDevicePixels="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  화살표: Path로 직접 그림 (왜곡 방지)  -->
                                            <Path
                                                x:Name="Arrow"
                                                Grid.Column="0"
                                                Width="10"
                                                Height="12"
                                                Data="M 0 0 L 6 6 L 0 12"
                                                Fill="White"
                                                RenderTransformOrigin="0.5,0.5"
                                                Stretch="Uniform">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>

                                            <!--  제목  -->
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{TemplateBinding Content}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </ToggleButton>

                                    <!--  본문  -->
                                    <Border
                                        x:Name="Body"
                                        Height="300"
                                        Margin="0,6,0,0"
                                        Padding="10"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <ScrollViewer
                                            MaxHeight="450"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <!--  이미지 경로는 기존 Tag 사용 유지  -->
                                            <Image
                                                SnapsToDevicePixels="True"
                                                Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                Stretch="Uniform" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <!--  트리거: 체크되면 본문 보이기 + 배경 강조 + 화살표 회전  -->
                                <ControlTemplate.Triggers>
                                    <Trigger SourceName="HeaderBtn" Property="IsChecked" Value="True">
                                        <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="HeaderBtn" Property="Background" Value="#0B1220" />
                                    </Trigger>
                                    <Trigger SourceName="HeaderBtn" Property="IsChecked" Value="False" />
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <!--  항목들: Content(헤더 텍스트), Tag(이미지 경로)  -->
            <ListBoxItem Content="(필수) 전자금융거래 이용약관" Tag="../../Assets/Image/Terms/Terms_ko-KR.png" />
            <ListBoxItem Content="(필수) 개인정보 수집·이용 동의" Tag="../../Assets/Image/Terms/Terms_ko-KR.png" />
            <ListBoxItem Content="(선택) 마케팅 정보 수신 동의" Tag="../../Assets/Image/Terms/Terms_ko-KR.png" />
        </ListBox>

        <Grid Grid.Row="2" Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Width="200"
                Height="80"
                Command="{Binding PreviousCommand}"
                Content="취소" />
            <Button
                Grid.Column="2"
                Width="200"
                Height="80"
                Command="{Binding NextCommand}"
                Content="서비스 동의" />
        </Grid>
    </Grid>
</UserControl>
