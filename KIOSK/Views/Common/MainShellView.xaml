<UserControl
    x:Class="KIOSK.Views.MainShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:KIOSK.ViewModels"
    xmlns:views="clr-namespace:KIOSK.Views"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">
    <Grid>
        <!--  중앙 콘텐츠 영역  -->
        <ContentControl
            x:Name="MainContent"
            Margin="0,0,0,100"
            Background="#2222F0"
            Content="{Binding CurrentViewModel}" />

        <!--  하단 바 (QR + 정보), Frame 위로 표시  -->
        <Grid
            Height="100"
            VerticalAlignment="Bottom"
            Panel.ZIndex="10"
            d:DataContext="{d:DesignInstance Type=viewModels:FooterViewModel}"
            Background="#170C37"
            DataContext="{Binding FooterViewModel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  QR 이미지  -->
            <Border
                Grid.Column="0"
                Width="100"
                Height="100"
                Margin="50,-30,20,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Source="{Binding LocationQr}"
                    Stretch="Fill" />
            </Border>

            <!--  아이콘 + 지점명 영역  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,-10,30,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="38"
                    Height="44"
                    Margin="0,0,10,0"
                    Source="{Binding LocationIconUri}" />
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontFamily="{StaticResource Pretendard}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding BranchName}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Margin="0,-10,30,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Pretendard}"
                    FontSize="{StaticResource FontSize_2XS}"
                    FontWeight="{StaticResource FontWeight_M}"
                    Foreground="{StaticResource WhiteBrush}"
                    Text="{Binding Date}"
                    Typography.NumeralAlignment="Tabular" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Pretendard}"
                    FontSize="{StaticResource FontSize_L}"
                    FontWeight="{StaticResource FontWeight_M}"
                    Foreground="{StaticResource WhiteBrush}"
                    Text="{Binding Time}"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
